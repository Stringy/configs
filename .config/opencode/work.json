{
  "$schema": "https://opencode.ai/config.json",
  "model": "enmaas/rits/zai-org/glm-5-3",
  "small_model": "openai/gpt-5.6-luna",
  "provider": {
    "enmaas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "EnMaaS",
      "options": {
        "baseURL": "https://api.enmaas.devshift.net/v1",
        "apiKey": "{env:ENMAAS_KEY}"
      },
      "models": {
        "rits/zai-org/glm-5-3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 2621444,
            "output": 65536
          }
        }
      }
    },
    "openai": {
      "options": {
        "baseURL": "https://api.enmaas.devshift.net/v1",
        "apiKey": "{env:ENMAAS_KEY}"
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "https://api.enmaas.devshift.net/v1",
        "apiKey": "{env:ENMAAS_KEY}"
      }
    },
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "skills": {
    "paths": [
      "/home/ghutton/code/go/src/github.com/stackrox/handbook/skills"
    ]
  },
  "permission": {
    "skill": {
      "*": "allow",
      "rit-*": "deny",
      "creating-rit-handover": "deny"
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra"
    },
    "build": {
      "model": "openai/gpt-5.6-terra"
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "/home/ghutton/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  }
}
