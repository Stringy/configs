{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "skills": {
    "paths": [
      "/home/ghutton/code/go/src/github.com/stackrox/handbook/skills"
    ]
  },
  "permission": {
    "skill": {
      "*": "allow",
      "rit-*": "deny",
      "creating-rit-handover": "deny"
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra"
    },
    "build": {
      "model": "openai/gpt-5.6-terra"
    },
    "general": {
      "model": "openai/gpt-5.6-terra"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    },
    "design": {
      "model": "openai/gpt-5.6-sol",
      "description": "Deep planning/design mode for complex architecture and detection-engine changes - read-only, uses GPT-5.6 Sol for maximum reasoning depth"
    },
    "jira": {
      "description": "General-purpose admin agent for Jira, Confluence, and Slack: search/read/create/update tickets and pages, track work status, post or read Slack messages. Delegate here for any ticket/admin/comms task that isn't code.",
      "mode": "all",
      "model": "openai/gpt-5.6-luna",
      "tools": {
        "atlassian-sooperset_*": true,
        "slack_*": true
      },
      "permission": {
        "atlassian-sooperset_confluence_search": "allow",
        "atlassian-sooperset_confluence_get_page": "allow",
        "atlassian-sooperset_confluence_get_page_children": "allow",
        "atlassian-sooperset_confluence_get_comments": "allow",
        "atlassian-sooperset_confluence_get_labels": "allow",
        "atlassian-sooperset_jira_search": "allow",
        "atlassian-sooperset_jira_get_issue": "allow",
        "atlassian-sooperset_jira_get_all_projects": "allow",
        "atlassian-sooperset_jira_get_transitions": "allow",
        "atlassian-sooperset_jira_get_worklog": "allow",
        "slack_get_channel_history": "allow",
        "slack_search_messages": "allow",
        "slack_get_thread": "allow",
        "slack_get_channel_id_by_name": "allow",
        "slack_whoami": "allow"
      }
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "/home/ghutton/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  }
}
