#!/bin/sh
# on-exit hook: only attempt a sync if this invocation actually added or
# modified a task. Taskwarrior only feeds on-exit hooks JSON for changed
# tasks (Hooks::onExit() -> tdb2.get_changes()), so read-only commands
# like `list`/`show`/`diagnostics` get empty stdin here - skip those
# instead of re-attempting a sync just because tw.syncneeded is still
# set from an earlier command.

changes=$(cat)
[ -n "$changes" ] || exit 0

[ "$(task rc.hooks:0 _get tw.syncneeded 2>/dev/null)" = "1" ] || exit 0

(
  flock 9
  task rc.hooks:0 sync
) 9>"$HOME/.cache/task-sync.lock"
