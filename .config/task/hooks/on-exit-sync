#!/bin/sh
# on-exit hook: synchronously sync whenever Taskwarrior reports unsynced
# local changes, so sync failures surface immediately in the terminal
# rather than silently in the background.

cat >/dev/null  # drain stdin per the on-exit interface contract

[ "$(task rc.hooks:0 _get tw.syncneeded 2>/dev/null)" = "1" ] || exit 0

(
  flock 9
  task rc.hooks:0 sync
) 9>"$HOME/.cache/task-sync.lock"
